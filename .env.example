# ============================================================
# Sculpt App — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# ── Supabase (Required) ─────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── OpenAI (Required for real photo analysis) ───────────────
# Get this from: https://platform.openai.com/api-keys
# Without this, photo analysis uses questionnaire-based inference
OPENAI_API_KEY=sk-...

# ── Stripe (Required for payments) ──────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
# Without this, checkout is simulated
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in Stripe Dashboard → Products
# Monthly plan price ID
STRIPE_PRICE_ID_MONTHLY=price_...
# Annual plan price ID
STRIPE_PRICE_ID_ANNUAL=price_...

# ── App URL ─────────────────────────────────────────────────
# Used for Stripe redirect URLs and OAuth callbacks
# Set to your production URL when deploying
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Replicate (Required for haircut previews) ────────────────
# Get this from: https://replicate.com/account/api-tokens
# Without this, haircut previews use a fallback mode
REPLICATE_API_TOKEN=r8_...
